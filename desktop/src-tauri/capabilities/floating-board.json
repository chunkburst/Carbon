{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating-board",
  "description": "Minimal permissions for Carbon's system-level floating task board.",
  "windows": ["floating-board"],
  "remote": {
    "urls": ["http://localhost:5173", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-close-floating-board",
    "allow-focus-main-task"
  ]
}
